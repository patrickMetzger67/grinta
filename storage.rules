rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Club logos used in invitation HTML emails (email clients cannot authenticate).
    match /logoClubs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Member photos and cached user avatars (app resolves via getDownloadURL).
    match /thumbs/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Tracker heatmap exports.
    match /tracker/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Session/match PDF reports linked from outbound emails (no auth in mail clients).
    // Path: sessionReports/{uid}/{filename}.pdf — multi-player reports with heatmaps
    // can exceed a few MB; keep a generous authenticated write limit.
    match /sessionReports/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf.*');
    }
  }
}
