rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Club logos used in invitation HTML emails (email clients cannot authenticate).
    match /logoClubs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Country flags for team create/edit (public read for Image.network).
    match /flags/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Member photos and cached user avatars (app resolves via getDownloadURL).
    match /thumbs/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Tracker heatmap exports.
    match /tracker/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Session/match PDF reports linked from outbound emails (no auth in mail clients).
    // Path: sessionReports/{uid}/{filename}.pdf — multi-player reports with heatmaps
    // can exceed a few MB; keep a generous authenticated write limit.
    // Public read so mailbox download links work without Firebase Auth.
    match /sessionReports/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf.*');
    }

    // Backward-compatible catch-all under sessionReports/ (legacy paths).
    match /sessionReports/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf.*');
    }

    // Coach workload analysis PDF reports (same public-read pattern as session reports).
    match /coachWorkloadReports/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf.*');
    }

    // Analyze-video uploads (web/tablet). Path: video/{uid}/{timestamp}_{name}.mp4
    // plus the 2D tactics sidecar: video/{uid}/{timestamp}_{name}.tactics.json
    match /video/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && (
          (
            request.resource.contentType.matches('video/mp4')
            && request.resource.size < 200 * 1024 * 1024
          )
          || (
            fileName.matches('.*\\.tactics\\.json$')
            && request.resource.contentType.matches('application/json.*')
            && request.resource.size < 8 * 1024 * 1024
          )
        );
    }
  }
}
