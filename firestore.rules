rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isRootUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isRoot', false) == true;
    }

    // Family/shared profiles: caller linked via member.userID or member.users.
    function memberLinkedToAuth(memberId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/member/$(memberId))
        && (
          get(/databases/$(database)/documents/member/$(memberId)).data.get('userID', '') == request.auth.uid
          || (
            get(/databases/$(database)/documents/member/$(memberId)).data.users is list
            && request.auth.uid in get(/databases/$(database)/documents/member/$(memberId)).data.users
          )
        );
    }

    // Wearable sync docs are stored under the member owner uid, which may differ
    // from the signed-in family account that manages the profile.
    function canAccessWearableSync(userId, playerId) {
      return request.auth != null
        && (request.auth.uid == userId || memberLinkedToAuth(playerId));
    }

    function isValidEntitlement(value) {
      return value in ['player', 'player_gps', 'coach_basic', 'coach_elite', 'coach_pro'];
    }

    function isValidPromoCodeCreate(codeId) {
      return request.resource.data.code == codeId
        && request.resource.data.code is string
        && request.resource.data.keys().hasAll([
          'code',
          'maxUses',
          'usedCount',
          'entitlement',
          'durationDays',
          'createdBy',
          'createdAt',
          'active',
        ])
        && request.resource.data.maxUses is int
        && request.resource.data.maxUses >= 1
        && request.resource.data.usedCount is int
        && request.resource.data.usedCount == 0
        && request.resource.data.durationDays is int
        && request.resource.data.durationDays >= 1
        && request.resource.data.entitlement is string
        && isValidEntitlement(request.resource.data.entitlement)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.active == true
        && (!('expiresAt' in request.resource.data)
          || request.resource.data.expiresAt is timestamp)
        && (!('teamId' in request.resource.data)
          || request.resource.data.teamId is string);
    }

    // Collections with dedicated write rules must not fall through to the catch-all.
    function isCatchAllWritePath() {
      return request.path.size() >= 5
        && (
          request.path[4] == 'admin_promo_codes'
          || request.path[4] == 'invitations'
          || request.path[4] == 'mail'
          || request.path[4] == 'pending_push'
          || request.path[4] == 'member'
          || request.path[4] == 'chat_polls'
          || request.path[4] == 'ads'
          || request.path[4] == 'share'
          || request.path[4] == 'shareScore'
          || request.path[3] == 'ads'
          || request.path[3] == 'share'
          || request.path[3] == 'shareScore'
          || (request.path[4] == 'users' && request.path.size() == 5)
        );
    }

    function isValidMailAttachment(entry) {
      return entry is map
        && entry.keys().hasAll(['content', 'filename', 'type', 'disposition'])
        && entry.content is string
        && entry.content.size() > 0
        && entry.filename is string
        && entry.filename.size() > 0
        && entry.type is string
        && entry.disposition is string;
    }

    function isValidMailAttachments() {
      return !('attachments' in request.resource.data)
        || (
          request.resource.data.attachments is list
          && request.resource.data.attachments.size() <= 3
          && (
            request.resource.data.attachments.size() == 0
            || isValidMailAttachment(request.resource.data.attachments[0])
          )
          && (
            request.resource.data.attachments.size() < 2
            || isValidMailAttachment(request.resource.data.attachments[1])
          )
          && (
            request.resource.data.attachments.size() < 3
            || isValidMailAttachment(request.resource.data.attachments[2])
          )
        );
    }

    function isValidMailCreate() {
      return request.resource.data.keys().hasAll(['to', 'message'])
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasAll(['subject', 'text', 'html'])
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string
        && request.resource.data.message.html is string
        && (!('from' in request.resource.data)
          || request.resource.data.from is string)
        && (!('replyTo' in request.resource.data)
          || request.resource.data.replyTo is string)
        && (!('clubId' in request.resource.data)
          || request.resource.data.clubId is string)
        && (!('pdfStoragePath' in request.resource.data)
          || (request.resource.data.pdfStoragePath is string
            && request.resource.data.pdfStoragePath.size() > 0
            && request.resource.data.pdfStoragePath.size() < 500))
        && (!('pdfFilename' in request.resource.data)
          || (request.resource.data.pdfFilename is string
            && request.resource.data.pdfFilename.size() > 0
            && request.resource.data.pdfFilename.size() < 200))
        && (!('pdfDownloadUrl' in request.resource.data)
          || (request.resource.data.pdfDownloadUrl is string
            && request.resource.data.pdfDownloadUrl.size() > 0
            && request.resource.data.pdfDownloadUrl.size() < 2000))
        && isValidMailAttachments()
        && !('delivery' in request.resource.data);
    }

    function isValidWhatsAppCreate() {
      return request.resource.data.keys().hasAll(['to', 'templateName', 'languageCode'])
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.to.size() < 32
        && request.resource.data.templateName is string
        && request.resource.data.templateName.size() > 0
        && request.resource.data.templateName.size() < 128
        && request.resource.data.languageCode is string
        && request.resource.data.languageCode.size() > 0
        && request.resource.data.languageCode.size() < 16
        && (!('bodyParameters' in request.resource.data)
          || (request.resource.data.bodyParameters is list
            && request.resource.data.bodyParameters.size() <= 10))
        && (!('clubId' in request.resource.data)
          || request.resource.data.clubId is string)
        && (!('kind' in request.resource.data)
          || request.resource.data.kind is string)
        && (!('invitationId' in request.resource.data)
          || request.resource.data.invitationId is string)
        && (!('invitationCode' in request.resource.data)
          || request.resource.data.invitationCode is string)
        && !('delivery' in request.resource.data);
    }

    // Shop ads collection only. request.path[3] is the first collection
    // (/databases/(default)/documents/{collection}/…). Do NOT use path[4]
    // (document id) — that would deny catch-all reads for any doc named "ads".
    function isAdsCollection() {
      return request.path.size() >= 4 && request.path[3] == 'ads';
    }

    function isValidAdCounterIncrement() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nbDisplay', 'nbClicks'])
        && request.resource.data.nbDisplay is int
        && request.resource.data.nbClicks is int
        && request.resource.data.nbDisplay >= resource.data.get('nbDisplay', 0)
        && request.resource.data.nbClicks >= resource.data.get('nbClicks', 0)
        && request.resource.data.nbDisplay - resource.data.get('nbDisplay', 0) <= 1
        && request.resource.data.nbClicks - resource.data.get('nbClicks', 0) <= 1
        && (
          request.resource.data.nbDisplay == resource.data.get('nbDisplay', 0)
          || request.resource.data.nbClicks == resource.data.get('nbClicks', 0)
        );
    }

    // Server-only OAuth / token collections (Phase 1 Whoop / Strava).
    function isServerOnlyCollection() {
      return request.path.size() >= 2
        && request.path[0] in [
          'whoop_integrations',
          'whoop_oauth_pending',
          'strava_integrations',
          'strava_oauth_pending',
          'polar_integrations',
          'polar_oauth_pending',
          'fitbit_integrations',
          'fitbit_oauth_pending',
          'oura_integrations',
          'oura_oauth_pending',
          'meta_integrations',
          'meta_oauth_pending'
        ];
    }

    // Signup: verify member invitation code and read sender profile (unauthenticated).
    match /invitations/{invitationId} {
      allow read: if resource.data.type == 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['validateUid', 'validateAt'])
        && request.resource.data.validateUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if request.auth == null
        || (request.auth != null && request.auth.uid == userId);

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !('isRoot' in request.resource.data)
        && !('subscriptionAccess' in request.resource.data);

      // isRoot + subscriptionAccess are server/admin only (Cloud Functions).
      // Once pending parental consent, only the CF may activate the account.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isRoot', 'subscriptionAccess'])
        && (
          resource.data.get('accountStatus', 'active') != 'pendingParentalConsent'
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'accountStatus',
              'parentalConsentToken',
              'parentalConsentAt',
              'physiologicalDataConsent',
              'physiologicalDataConsentAt',
              'physiologicalDataConsentVersion',
              'physiologicalDataConsentSource',
            ])
        );

      allow delete: if request.auth != null && request.auth.uid == userId;

      // Session active + feature discovery (per-user app state).
      match /app_state/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Opponent stats view tracking for reminder deduplication.
      match /app_state/opponent_stats_views/views/{matchId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Whoop connection metadata (no tokens — server stores tokens separately).
      match /whoopSync/{playerId} {
        allow read, write: if canAccessWearableSync(userId, playerId);
      }

      // Strava connection metadata (no tokens — server stores tokens separately).
      match /stravaSync/{playerId} {
        allow read, write: if canAccessWearableSync(userId, playerId);
      }

      // Polar connection metadata (no tokens — server stores tokens separately).
      match /polarSync/{playerId} {
        allow read, write: if canAccessWearableSync(userId, playerId);
      }

      // Fitbit connection metadata (no tokens — server stores tokens separately).
      match /fitbitSync/{playerId} {
        allow read, write: if canAccessWearableSync(userId, playerId);
      }

      // Oura connection metadata (no tokens — server stores tokens separately).
      match /ouraSync/{playerId} {
        allow read, write: if canAccessWearableSync(userId, playerId);
      }

      // Meta (IG/FB) connection metadata (no tokens — server stores tokens).
      match /metaSync/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Apple Health connection metadata (on-device HealthKit — no OAuth tokens).
      match /appleHealthSync/{playerId} {
        allow read, write: if canAccessWearableSync(userId, playerId);
      }

      // Google Health Connect metadata (on-device — no OAuth tokens).
      match /googleHealthSync/{playerId} {
        allow read, write: if canAccessWearableSync(userId, playerId);
      }

      // Individual Intense GPS claim metadata (serial → TRACKER_* association).
      match /intenseGpsSync/{playerId} {
        allow read, write: if canAccessWearableSync(userId, playerId);
      }

      // FCM device tokens (doc id = token). Owner read/write only.
      // Other signed-in clients read tokens when sending push (convocation, etc.).
      match /fcmTokens/{tokenId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == userId;
        allow delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Whoop OAuth tokens — Cloud Functions / Admin SDK only.
    match /whoop_integrations/{integrationId} {
      allow read, write: if false;
    }

    match /whoop_oauth_pending/{stateId} {
      allow read, write: if false;
    }

    // Strava OAuth tokens — Cloud Functions / Admin SDK only.
    match /strava_integrations/{integrationId} {
      allow read, write: if false;
    }

    match /strava_oauth_pending/{stateId} {
      allow read, write: if false;
    }

    // Polar OAuth tokens — Cloud Functions / Admin SDK only.
    match /polar_integrations/{integrationId} {
      allow read, write: if false;
    }

    match /polar_oauth_pending/{stateId} {
      allow read, write: if false;
    }

    // Fitbit OAuth tokens — Cloud Functions / Admin SDK only.
    match /fitbit_integrations/{integrationId} {
      allow read, write: if false;
    }

    match /fitbit_oauth_pending/{stateId} {
      allow read, write: if false;
    }

    // Oura OAuth tokens — Cloud Functions / Admin SDK only.
    match /oura_integrations/{integrationId} {
      allow read, write: if false;
    }

    match /oura_oauth_pending/{stateId} {
      allow read, write: if false;
    }

    // Meta Graph tokens — Cloud Functions / Admin SDK only.
    match /meta_integrations/{integrationId} {
      allow read, write: if false;
    }

    match /meta_oauth_pending/{stateId} {
      allow read, write: if false;
    }

    // Platform admin promo codes — managed by isRoot users, redeemed via Cloud Function.
    match /admin_promo_codes/{codeId} {
      allow read, update, delete: if isRootUser();
      allow create: if isRootUser() && isValidPromoCodeCreate(codeId);
    }

    // Shared tracker owners (managed by isRoot from the Grinta admin panel).
    // This rule is additive: the catch-all below still grants authenticated
    // read/write so goaltimefootball's existing access is preserved. It is
    // intentionally NOT listed in isCatchAllWritePath().
    match /TRACKER_Owner/{ownerId} {
      allow read, write: if isRootUser();
    }

    // Shop ads promoting shop.grinta.io. Clients may increment counters only.
    match /ads/{adId} {
      allow read: if request.auth != null;
      allow create, delete: if isRootUser();
      allow update: if isRootUser() || isValidAdCounterIncrement();
    }

    // Shared tracker devices and owner assignments (managed by isRoot from Grinta admin).
    // Additive: catch-all below still grants authenticated read/write for goaltimefootball.
    match /TRACKER_Device/{deviceId} {
      allow read, write: if isRootUser();
    }

    match /TRACKER_DeviceOwner/{assignmentId} {
      allow read, write: if isRootUser();
    }

    // Remote app config (subscription limits, e-shop flags, invitation emails).
    match /config/{docId} {
      allow read: if request.auth != null
        && docId in [
          'subscription_limits',
          'eshop',
          'invitation',
          'activity',
          'playerPositions',
          'countries',
          'youtube'
        ];
      allow write: if isRootUser()
        && docId in [
          'subscription_limits',
          'eshop',
          'invitation',
          'activity',
          'playerPositions',
          'countries',
          'youtube'
        ];
    }

    // Member self-registration without invitation code.
    match /member/{memberId} {
      allow create: if request.auth != null
        && request.resource.data.userID == request.auth.uid
        && request.resource.data.creatorUserId == request.auth.uid
        && request.resource.data.users is list
        && request.auth.uid in request.resource.data.users;

      allow read: if isRootUser()
        || (
          request.auth != null
          && resource.data.users is list
          && request.auth.uid in resource.data.users
        );

      allow delete: if isRootUser()
        || (
          request.auth != null
          && resource.data.creatorUserId == request.auth.uid
          && resource.data.users is list
          && resource.data.users.size() == 1
          && request.auth.uid in resource.data.users
        );

      allow update: if isRootUser()
        || (
          request.auth != null
          && (
            (resource.data.users is list && request.auth.uid in resource.data.users)
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users'])
              && request.resource.data.users is list
              && request.auth.uid in request.resource.data.users
              && !(request.auth.uid in resource.data.get('users', []))
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['keyMember'])
              && resource.data.users is list
              && request.auth.uid in resource.data.users
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users', 'userID'])
              && resource.data.users is list
              && request.auth.uid in resource.data.users
              && request.resource.data.users is list
              && !(request.auth.uid in request.resource.data.users)
            )
          )
        );
    }

    // Invitation emails queued by authenticated coaches (sendMailOnCreate Cloud Function).
    match /mail/{mailId} {
      allow create: if request.auth != null && isValidMailCreate();
      allow read, update, delete: if false;
    }

    // WhatsApp template messages (sendWhatsAppOnCreate / Meta Cloud API).
    match /whatsapp_messages/{messageId} {
      allow create: if request.auth != null && isValidWhatsAppCreate();
      allow read, update, delete: if false;
    }

    // Meta WhatsApp webhook raw events — Cloud Functions / Admin SDK only.
    match /whatsapp_webhook_events/{eventId} {
      allow read, write: if false;
    }

    function isValidShareCreate() {
      return request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.shareAt is timestamp
        && request.resource.data.statId is string
        && request.resource.data.statId.size() > 0
        && request.resource.data.statId.size() < 256
        && request.resource.data.statType is string
        && request.resource.data.statType.size() > 0
        && request.resource.data.statType.size() < 64
        && request.resource.data.where is string
        && request.resource.data.where.size() > 0
        && request.resource.data.where.size() < 64
        && request.resource.data.get('views', 0) == 0
        && request.resource.data.get('interactions', 0) == 0
        && !('lastSyncedAt' in request.resource.data);
    }

    function isValidShareScoreCreate(scoreUserId) {
      return request.auth != null
        && request.auth.uid == scoreUserId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.shareCount == 1
        && request.resource.data.sharePoints == 10
        && request.resource.data.totalPoints == 10
        && request.resource.data.get('views', 0) == 0
        && request.resource.data.get('interactions', 0) == 0
        && request.resource.data.get('viewPoints', 0) == 0
        && request.resource.data.get('interactionPoints', 0) == 0;
    }

    function isValidShareScoreShareIncrement(scoreUserId) {
      return request.auth != null
        && request.auth.uid == scoreUserId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['shareCount', 'sharePoints', 'totalPoints', 'updatedAt'])
        && request.resource.data.shareCount == resource.data.shareCount + 1
        && request.resource.data.sharePoints == resource.data.sharePoints + 10
        && request.resource.data.totalPoints == resource.data.totalPoints + 10;
    }

    // Native share receipts (synthèse / fiche performance). Singular `share`
    // matches team / season / ranking. views / interactions / lastSyncedAt
    // are reserved for the Node batch (Admin SDK).
    match /share/{shareId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if isValidShareCreate();
      allow update, delete: if false;
    }

    // Per-user share ranking totals. views / interactions are batch-only.
    match /shareScore/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if isValidShareScoreCreate(userId);
      allow update: if isValidShareScoreShareIncrement(userId);
      allow delete: if false;
    }

    // Deferred FCM pushes (quiet hours) — Cloud Functions / Admin SDK only.
    match /pending_push/{pushId} {
      allow read, write: if false;
    }

    // Chat polls: definition + per-user votes (Stream message is the carrier).
    match /chat_polls/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      match /votes/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null
          && request.auth.uid == uid;
      }
    }

    function teamListHasAuth(fieldName) {
      return resource.data.get(fieldName, []) is list
        && request.auth.uid in resource.data.get(fieldName, []);
    }

    // Owner, listed manager, owner-kit, or linked user may update a team.
    function canManageTeamDoc() {
      return request.auth != null
        && (
          resource.data.get('uid', '') == request.auth.uid
          || teamListHasAuth('managers')
          || teamListHasAuth('owners')
          || teamListHasAuth('users')
        );
    }

    // Roster / staff mutations (remove player, etc.). Additive with catch-all.
    match /team/{teamId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if canManageTeamDoc();
    }

    // Catch-all for the rest of the app (matches deployed prod behavior).
    // Excludes paths above so dedicated rules are enforced (Firestore ORs allows).
    // Ads are excluded from public catch-all read so match /ads/{adId} applies.
    // Team / club / member / season reads stay on the same allow as before.
    match /{document=**} {
      allow read: if !isServerOnlyCollection() && !isAdsCollection();
      allow write: if request.auth != null && !isCatchAllWritePath();
    }
  }
}
