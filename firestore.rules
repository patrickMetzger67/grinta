rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signup: verify member invitation code and read sender profile (unauthenticated).
    match /invitations/{invitationId} {
      allow read: if resource.data.type == 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['validateUid', 'validateAt'])
        && request.resource.data.validateUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if request.auth == null
        || (request.auth != null && request.auth.uid == userId);

      // Session active + feature discovery (per-user app state).
      match /app_state/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Member self-registration without invitation code.
    match /member/{memberId} {
      allow create: if request.auth != null
        && request.resource.data.userID == request.auth.uid
        && request.resource.data.creatorUserId == request.auth.uid
        && request.resource.data.users is list
        && request.auth.uid in request.resource.data.users;

      allow read: if request.auth != null
        && resource.data.users is list
        && request.auth.uid in resource.data.users;

      allow update: if request.auth != null
        && (
          (resource.data.users is list && request.auth.uid in resource.data.users)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users'])
            && request.resource.data.users is list
            && request.auth.uid in request.resource.data.users
            && !(request.auth.uid in resource.data.get('users', []))
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['keyMember'])
            && resource.data.users is list
            && request.auth.uid in resource.data.users
          )
        );
    }
  }
}
