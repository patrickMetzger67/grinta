    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta utilise le Bluetooth pour détecter et connecter les capteurs Polar du kit équipe. / Grinta uses Bluetooth to discover and connect Polar team-kit sensors."
          }
        }
      }
    },
    "NSBluetoothPeripheralUsageDescription" : {
      "comment" : "Privacy - Bluetooth Peripheral Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta utilise le Bluetooth pour détecter et connecter les capteurs Polar du kit équipe. / Grinta uses Bluetooth to discover and connect Polar team-kit sensors."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta synchronise vos matchs et entraînements avec le calendrier de votre téléphone. / Grinta syncs your matches and training sessions with your phone calendar."
          }
        }
      }
    },
    "NSCalendarsUsageDescription" : {
      "comment" : "Privacy - Calendars Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta synchronise vos matchs et entraînements avec le calendrier de votre téléphone. / Grinta syncs your matches and training sessions with your phone calendar."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta uses the camera to take a profile photo or attach photos in team chat — for example, when you tap Change photo on Edit profile. / Grinta utilise l’appareil photo pour une photo de profil ou des pièces jointes dans le chat — par exemple via Modifier la photo sur Modifier mon profil."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta utilise Face ID pour déverrouiller l'application et vous reconnecter rapidement lorsque vous l'avez activé. / Grinta uses Face ID to unlock the app and sign you back in quickly when you enable it."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta lit vos entraînements Apple Forme / Santé (durée, distance, calories, fréquence cardiaque) pour les importer dans votre agenda et, si vous l'autorisez, les partager avec votre coach. / Grinta reads your Apple Fitness / Health workouts (duration, distance, calories, heart rate) to import them into your agenda and, when you allow it, share them with your coach."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta peut enregistrer vos séances d'entraînement et matchs (durée, distance) dans Apple Santé / Forme lorsque vous l'autorisez après une synchronisation. / Grinta can save your training and match sessions (duration, distance) to Apple Health / Fitness when you allow it after a sync."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grinta nutzt Ihren Standort, um die Karte bei der Spielfeld-Geolokalisierung für GPS-Heatmaps zu zentrieren — zum Beispiel unter Feldlokalisierung. Der Standort wird nur während der App-Nutzung angefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grinta uses your location to center the map when you set a pitch location for GPS heatmaps — for example, when geolocating your stadium in Field localization. Location is only requested while you use the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grinta utiliza tu ubicación para centrar el mapa al localizar un campo para heatmaps GPS — por ejemplo en Localización del campo. La ubicación solo se solicita mientras usas la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grinta utilise votre position pour centrer la carte lorsque vous localisez un terrain pour les heatmaps GPS — par exemple dans Localisation du terrain. La position n’est demandée que pendant l’utilisation de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grinta utilizza la tua posizione per centrare la mappa quando localizzi un campo per le heatmap GPS — ad esempio in Localizzazione campo. La posizione viene richiesta solo durante l’uso dell’app."
          }
        }
      }
    },
