    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta needs microphone access to record voice messages in team chat and to ask the AI assistant (Ask Gio) questions by voice. / Grinta a besoin du micro pour les messages vocaux du chat d’équipe et pour poser des questions à Ask Gio à la voix."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta uses your photo library to set a profile picture or share images in team chat — for example, when you choose an existing photo on Edit profile. / Grinta utilise votre photothèque pour une photo de profil ou le chat d’équipe — par exemple en choisissant une photo existante sur Modifier mon profil."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Grinta uses speech recognition so you can ask the AI assistant (Ask Gio) questions by voice. / Grinta utilise la reconnaissance vocale pour poser des questions à Ask Gio à la voix."
          }
        }
      }
